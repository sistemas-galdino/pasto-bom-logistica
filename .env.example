ORIX_BASE_URL=http://177.71.135.247:19201/ws/integradores/v1
ORIX_LOGIN=api ia
ORIX_SENHA=123
ORIX_EMPRESA=2
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
EVOLUTION_URL=
EVOLUTION_INSTANCE=
EVOLUTION_API_KEY=
# Modo teste de WhatsApp: se preenchido, TODOS os envios vão para este número
# (e não para o cliente). Deixe vazio em produção. Ex.: 5514998859650
WHATSAPP_NUMERO_TESTE=
POLL_CRON=*/5 * * * *
# Varredura profunda: um ano de pedidos nos status de gatilho. Pega o pedido
# ANTIGO que só agora entrou no gatilho — o 00027 "Parcial" chega dias ou meses
# depois da data do pedido, e a API do Órix só filtra por data.
#
# O CHECK_CRON não é o horário da varredura, é de quanto em quanto tempo o
# worker VERIFICA se já está na hora. Horário fixo não serve: nem o Órix nem o
# servidor ficam de pé de madrugada, e um cron noturno abortaria todo dia.
VARREDURA_CHECK_CRON=15 * * * *
VARREDURA_INTERVALO_HORAS=20
API_PORT=3333
ALLOW_NO_AUTH=true
# frontend (apps/frontend/.env):
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:3333
